      "targets": [{ "expr": "sum(increase(game_thumbs_http_responses_total{job=~\"$job\", instance=~\"$instance\", status_class=~\"2xx|3xx\"}[$__range])) / clamp_min(sum(increase(game_thumbs_http_responses_total{job=~\"$job\", instance=~\"$instance\"}[$__range])), 1)", "refId": "A" }],
      "title": "Successful Responses",
