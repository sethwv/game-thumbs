  "description": "Usage analytics for Game Thumbs. Requires Prometheus to scrape GET /metrics with METRICS_ENABLED=true. Counters reset when the application restarts; Prometheus rate() and increase() handle resets when enough samples are available. League, endpoint, response, and cache metrics are independently aggregated, so they cannot be filtered together. Cache panels measure the application image cache, not a browser or CDN cache.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [{ "expr": "sum(increase(game_thumbs_http_requests_total{job=~\"$job\", instance=~\"$instance\"}[$__range]))", "refId": "A" }],
      "title": "Requests in Selected Range",
      "type": "stat"
    },
    {
